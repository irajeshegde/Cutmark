{
  "name": "audioslice",
  "description": "Cut, split, trim, and time-mark MP3, WAV, M4A and other audio files entirely in the browser. No uploads, no server, no storage.",
  "private": true,
  "version": "0.2.0",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "brand-images": "node scripts/make-brand-images.mjs",
    "predev": "node scripts/copy-ffmpeg-core.mjs",
    "dev": "vite --port=3947 --host=0.0.0.0",
    "prebuild": "node scripts/copy-ffmpeg-core.mjs",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "lint": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "check": "npm run lint && npm test && npm run build",
    "clean": "node -e \"require('fs').rmSync('dist',{recursive:true,force:true})\"",
    "test:e2e": "playwright test"
  },
  "dependencies": {
    "@ffmpeg/ffmpeg": "^0.12.15",
    "@ffmpeg/util": "^0.12.2",
    "@fontsource-variable/geist": "^5.3.0",
    "@fontsource-variable/jetbrains-mono": "^5.3.0",
    "@fontsource/instrument-serif": "^5.3.0",
    "@vercel/analytics": "^2.0.1",
    "jszip": "^3.10.1",
    "lucide-react": "^0.546.0",
    "react": "^19.0.1",
    "react-dom": "^19.0.1",
    "wavesurfer.js": "^7.12.11"
  },
  "devDependencies": {
    "@ffmpeg/core": "^0.12.6",
    "@playwright/test": "^1.65.1",
    "@tailwindcss/vite": "^4.1.14",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.13",
    "@types/node": "^22.14.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^5.0.4",
    "jsdom": "^31.0.1",
    "tailwindcss": "^4.1.14",
    "typescript": "~5.8.2",
    "vite": "^6.2.3",
    "vitest": "^3.2.7"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/irajeshegde/AudioSlice.git"
  },
  "engines": {
    "node": ">=20"
  }
}
